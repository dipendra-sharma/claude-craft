#!/bin/bash
set -uo pipefail
source "$(dirname "$0")/../scripts/lib.sh"

if [ $# -eq 0 ]; then
  printf 'Usage: craft-allow <file path>...\n\nAllows hand edits to a guarded manifest or lockfile for 30 minutes.\nSay why in your reply before running it.\n' >&2
  exit 1
fi

for target in "$@"; do
  case "$target" in
    /*) path=$target ;;
    *) path="$PWD/${target#./}" ;;
  esac
  printf '%s\t%s\n' "$(date +%s)" "$path" >> "$(craft_allow_file)"
  printf 'craft: allowed edits to %s for 30 minutes\n' "$path"
done
